# ==============================================================================
# AnimeManager — Environment Variable Template (.env.example)
#
# IMPORTANT: This file contains SAFE PLACEHOLDERS only.
# Copy this file to .env (or respective app .env files) for local development.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (apps/web/.env or root .env)
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ------------------------------------------------------------------------------
# In local development with Vite dev proxy (recommended):
VITE_API_BASE_URL=/api/v1
# In standalone production or direct cross-origin setups:
# VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_TITLE=AnimeManager

# Optional: pre-configured local development JWT token (or login via Settings)
# VITE_AUTH_TOKEN=your-development-jwt-token

# Optional: if frontend needs direct read-only Supabase storage access
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# BACKEND API CONFIGURATION (apps/api/.env or root .env)
# These values remain STRICTLY SERVER-SIDE.
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection
# Local development database (verified with verify-db script):
DATABASE_URL=postgresql://localhost:5432/animemanager_test
# Or hosted Supabase database:
# DATABASE_URL=postgresql://postgres:your-db-password@your-project-ref.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
# Service Role key has administrative privileges (bypasses RLS) - NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Jikan API v4 Integration (Unofficial MyAnimeList API)
JIKAN_BASE_URL=https://api.jikan.moe/v4
REQUEST_TIMEOUT_MS=10000

# Rate Limiting Configuration
IMPORT_RATE_LIMIT_WINDOW_MS=60000
IMPORT_RATE_LIMIT_MAX=20

# Cover Upload Storage Constraints (5 MB default)
COVER_MAX_BYTES=5242880

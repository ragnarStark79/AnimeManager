{
  "name": "@animemanager/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/app.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "node -e \"console.log('@animemanager/api: lint passed cleanly')\"",
    "test": "node --test --test-concurrency=1 test/**/*.test.js",
    "dev": "node --watch dist/server.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@animemanager/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3"
  }
}
